APP_NAME=PromptOps
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=promptops
DB_USERNAME=promptops
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

LLM_PROVIDER=openai   # openai | anthropic | fake (no API key required)
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-placeholder
ANTHROPIC_MODEL=claude-haiku-3-5-20251001

SANCTUM_STATEFUL_DOMAINS=localhost:5173
